# PhytoSense AI Environment Configuration Template
# Copy this file to .env before starting the services

# Environment Mode
ENVIRONMENT=development
SIMULATION_MODE=true
DEBUG=true

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=phytosense-super-secret-dev-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Supabase / PostgreSQL)
# For local dev, a standard postgres connection works:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phytosense_db
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SIMULATION_NOTICE="SIMULATION / NOT EXPERIMENTALLY VALIDATED"

# Simulator Settings
SIMULATOR_TICK_SECONDS=10
SIMULATOR_ACCELERATION_FACTOR=1.0
DEFAULT_SIMULATED_PLANT_ID=PALM-001

# Telemetry & LoRa Gateway (Optional for field integration)
LORA_GATEWAY_AUTH_TOKEN=gateway-token-secret-865mhz
