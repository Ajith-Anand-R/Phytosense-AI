// PhytoHydra v1 - shared parameters (all dimensions in mm)
// Open any part file in OpenSCAD (free, openscad.org), press F6, then File > Export > STL.
trunk_d      = 170;   // measure girth with a tape: trunk_d = girth / 3.1416
trunk_r      = trunk_d / 2;
wall         = 2.4;   // printed wall thickness (PA12, ASA or PETG)
strap_w      = 20;    // TPU strap / stainless band width
strap_t      = 2.2;
$fn          = 96;
